---
import Layout from '../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import type { astroCalledServerError } from 'astro:actions';

/* Placeholder projekt */
const projects = await getCollection('projects'); 
const sortedProjects = projects.sort((a, b) => parseInt(b.data.year) - parseInt(a.data.year));
const featuredProject = sortedProjects[1];

---

<Layout title="Adam Skoglund | Portfolio ">
	<section class="hero-section">
		<a href={`projects/${featuredProject.slug}`} class="hero-link">
			<div class="hero-image-container">
				<img src={featuredProject.data.heroImage} alt={featuredProject.data.title} class="hero-img" />
				
				<div class="hero-overlay">
					<h2 class="hero-title">{featuredProject.data.title}</h2>
					<span class="meta-text">Show Project</span>
				</div>
			</div>
		</a>
	</section>

	<section class="project-list">
		<div class="list-header meta-text">
			<span>Project</span>
			<span>Year / Category</span>
		</div>
		
		<hr />

		<ul>
			{sortedProjects.map((project) => (
				<li>
					<a href={`projects/${project.slug}`} class="project-row">
						<span class="project-name">{project.data.title}</span>
						<span class="project-meta meta-text">{project.data.year} - {project.data.category}</span>
					</a>

				</li>
			))}

		</ul>
	</section>

</Layout>

<style>

/* Hero style*/
	.hero-section {
		margin-bottom: var(--spacing-lg);
		height: 70vh;
		width: 100%;
	}

	.hero-link {
		display: block;
		height: 100%;
		width: 100%;
		position: relative;
	}

	.hero-image-container {
		width: 100%;
		height: 100%;
		position: relative;
		overflow: hidden;
		background-color: #f0f0f0;	
	}

	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(255, 255, 255, 0.0);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		opacity: 0;
		transition: all 0.4s ease;
	}

	.hero-link:hover .hero-overlay {
		background: rgba(255, 255, 255, 0.3);
		opacity: 1;
		cursor: pointer;
	}

	.hero-link:hover .hero-img {
		transform: scale(1.02);
	}

	.hero-title {
		font-size: 3rem;
		color: #000;
		margin-bottom: 1rem;
	}

	/* Projectlist Style */
	.project-list {
		margin-bottom: var(--spacing-lg);
	}

	.list-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.5rem;
		opacity: 0.6;
	}

	hr {
		border: 0;
		border-top: 1px solid #000;
		margin-bottom: 1rem;
	}

	ul {
		list-style: none;
	}

	.project-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
		transition: opacity 0.2s;
	}

	.project-row:hover {
		opacity: 0.6;
	}

	.project-name {
		font-size: 1.5rem;
		font-weight: 500;
	}

	.project-meta {
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.hero-title {
			font-size: 2rem;
		}
		.project-name {
			font-size: 1.2rem;
		}
	}
</style>
