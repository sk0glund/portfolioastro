---
import Layout from '../layouts/Layout.astro';
import CvPortrait from '/public/cv-portrait.jpg';
import { Image } from 'astro:assets';

/* Data-objekt för enkel redigering senare */
const contactData = {
    role: "Architecture & Engineering Student",
    email: "skoglundadam1@gmail.com",
    school: "Chalmers University of Technology",
    address: "Gothenburg, Sweden",
    linkedin: "linkedin.com/in/askoglund",
    linkedinUrl: "https://www.linkedin.com/in/askoglund/",
};
---

<Layout title="Contact | Adam Skoglund" hideContact={true}>
    <section class="contact-grid">
        
        <div class="image-column">
            <figure class="portrait-frame">
                <Image src={CvPortrait} alt="Portrait" class="portrait-img" />
            </figure>
        </div>
        
        <div class="info-column">
            <a class="info-text">{contactData.role}</a>
            <a class="info-text">{contactData.school}</a>
            <a class="info-text">{contactData.address}</a>
            <a href="mailto:{contactData.email}" class="info-text, info-link">{contactData.email}</a>
            <a href={contactData.linkedinUrl} class="info-text, info-link">{contactData.linkedin}</a>
        </div>
    </section>
</Layout>

<style>
    .contact-grid {
        display: grid;
        grid-template-columns: 1 1;
        align-items: stretch;
        padding-top: var(--spacing-lg);
        gap: var(--spacing-xs);
    }

    .info-column {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }
    .info-text {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
    }

    /* Links */
    .info-link {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
    }

    .info-link:hover {
        text-decoration: underline;
    }

    .image-column {
        display: flex;
        justify-content: flex-start;
        margin-bottom: var(--spacing-lg)
    }

    .portrait-frame {
        max-width: 100%;
        height: 100%;
        max-width: 150px;
        aspect-ratio: 3/4;
        background-color: #f0f0f0;
        overflow: hidden;
    }

    .portrait-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%);
        transition: filter 0.5s ease;
    }

    .portrait-img:hover {
        filter: grayscale(30%);
    }

    /* Desktop Layout */
    @media (min-width: 768px) {
        .contact-grid {
            grid-template-columns: auto 1fr;
            gap: var(--spacing-lg);
        }
    }
</style>