---
import '../styles/global.css';

interface Props {
    title: string;
    hideContact?: boolean;
}

const {title, hideContact = false} = Astro.props;
---

<!DOCTYPE html>
<html lang="sv">
    <head>
        <meta charset="UTF-8"/>
        <meta name="description" content="Adam Skoglund - Architectural Portfolio" />
        <meta name="keyword" content="Arkitektur Teknik, Architecture Portfolio, Architecture and Engineering" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" type="image/svg+xml" href="/"/>
        <link rel="stylesheet" href="global.css">

        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <div class="header-left">
                <a href="/" class="site-title">Adam Skoglund</a>
            </div>
            <div class="header-right">
                {!hideContact && <a href="/cv" class="meta-text nav-link">Contact</a>}
            </div>
        </header>

        <main>
            <slot />
        </main>
    </body>
</html>

<style>
    .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-sm);
        width: 100%;
        max-width: var(--container-max);
        margin: 0 auto;
        background: rgba(255,255,255,0.9);
        z-index: 100;
        border-bottom: 1px solid transparent;
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
    }

    .site-title {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.1rem;
        text-transform: uppercase;
    }


    .nav-link {
        font-family: var(--font-heading);
        font-weight: 400;
        font-size: 1.0rem;
        text-transform: uppercase;
    }
    .nav-link:hover {
        text-decoration: underline;
    }

    main {
        padding-left: var(--spacing-sm);
        padding-right: var(--spacing-sm);
        max-width: var(--container-max);
        margin: 0 auto;
    }

    @media (min-width: 768px) {
        .site-header {
            padding: var(--spacing-md) var(--spacing-xl);
        }
        main {
            padding-left: var(--spacing-xl);
            padding-right: var(--spacing-xl);
        }
    }

</style>
